# ==========================================
# Gold AI Trading Analysis - Environment Configuration
# ==========================================

# Application Settings
APP_NAME="Gold AI Trading Analysis"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Gold Market Data API Configuration
# Provider choices: "goldprice_dev", "yahoo_finance", "hybrid" (default: "hybrid")
MARKET_DATA_PROVIDER="hybrid"

# GoldPrice.dev API Key (Optional for free spot/daily bars; required for Pro intraday bars)
# Get a key at: https://goldprice.dev
GOLDPRICE_DEV_API_KEY=""

# AI Provider Configuration
# Options: "auto" (default: uses Gemini/OpenAI if key provided, otherwise uses intelligent heuristic fallback),
#          "gemini", "openai", "fallback"
AI_PROVIDER="auto"
AI_MODEL="gemini-3.6-flash"

# AI API Keys (Leave blank to use intelligent built-in fallback mode)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# AI Caching & Timeout
AI_REQUEST_TIMEOUT_SECONDS=25.0
AI_CACHE_TTL_SECONDS=120

# Default Instrument
DEFAULT_SYMBOL="XAU-USD-SPOT"

# Cache TTL in seconds (to avoid redundant API requests)
PRICE_CACHE_TTL_SECONDS=10
CANDLE_CACHE_TTL_SECONDS=60

# Request Timeout (seconds)
HTTP_TIMEOUT_SECONDS=15
